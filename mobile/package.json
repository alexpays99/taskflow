{
  "name": "TaskFlow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android --mode=developmentDebug --appIdSuffix=dev",
    "android:dev": "react-native run-android --mode=developmentDebug --appIdSuffix=dev",
    "android:staging": "react-native run-android --mode=stagingDebug --appIdSuffix=staging",
    "android:prod": "react-native run-android --mode=productionDebug",
    "android:release": "react-native run-android --mode=productionRelease",
    "ios": "react-native run-ios",
    "ios:dev": "ENVFILE=.env.development react-native run-ios --scheme TaskFlowDev",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --scheme TaskFlowStaging",
    "ios:prod": "ENVFILE=.env.production react-native run-ios --scheme TaskFlow",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "pod-install": "cd ios && pod install && cd ..",
    "clean": "cd android && ./gradlew clean && cd .. && rm -rf ios/build",
    "clean:all": "rm -rf node_modules ios/Pods ios/build android/build android/app/build && npm install && npx pod-install"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.10",
    "@react-navigation/native-stack": "^6.9.18",
    "@shopify/flash-list": "^1.6.3",
    "@tanstack/react-query": "^5.18.1",
    "axios": "^1.6.5",
    "date-fns": "^3.3.1",
    "i18next": "^23.8.2",
    "react": "18.2.0",
    "react-hook-form": "^7.50.0",
    "react-i18next": "^14.0.3",
    "react-native": "^0.73.11",
    "react-native-config": "1.5.1",
    "react-native-gesture-handler": "2.14.1",
    "react-native-image-crop-picker": "0.40.3",
    "react-native-mmkv": "2.11.0",
    "react-native-reanimated": "3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "3.29.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/preset-env": "^7.23.8",
    "@babel/runtime": "^7.23.8",
    "@react-native/babel-preset": "^0.73.19",
    "@react-native/eslint-config": "^0.73.2",
    "@react-native/metro-config": "^0.73.3",
    "@react-native/typescript-config": "^0.73.1",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.11",
    "@types/react": "^18.2.48",
    "@types/react-test-renderer": "^18.0.7",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.2.4",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
